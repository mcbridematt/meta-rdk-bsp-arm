From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rostyslav Lesovyi <rostyslav.lesovyi@globallogic.com>
Date: Mon, 21 Sep 2026 17:27:12 +2000
Subject: [PATCH] Route6_GetIfNames: do not probe erouter0/wan0

---
 source-arm/TR-181/board_sbapi/cosa_routing_apis.c | 37 ++++++++++++++--------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/source-arm/TR-181/board_sbapi/cosa_routing_apis.c b/source-arm/TR-181/board_sbapi/cosa_routing_apis.c
--- a/source-arm/TR-181/board_sbapi/cosa_routing_apis.c
+++ b/source-arm/TR-181/board_sbapi/cosa_routing_apis.c
@@ -3218,6 +3218,9 @@
 static int
 Route6_GetIfNames(char iflist[][IFNAME_SIZ], int *nlist)
 {
+    char wan_ifname[IFNAME_SIZ] = {0};
+    int n = 0;
+
     if (!iflist || !nlist)
         return -1;
 
@@ -3226,20 +3229,19 @@
     if (ifnum <= 0)
     {
 #endif
-        if (*nlist < 2)
+        if (*nlist < 3)
             return -1;
 
-        snprintf(iflist[0], IFNAME_SIZ, "%s", "erouter0");
-        snprintf(iflist[1], IFNAME_SIZ, "%s", "brlan0");
-#if defined (_COSA_BCM_MIPS_) || defined(_ENABLE_DSL_SUPPORT_)
-        snprintf(iflist[2], IFNAME_SIZ, "%s", "lo");
-        *nlist = 3;
-#else
-        snprintf(iflist[2], IFNAME_SIZ, "%s", "wan0");
-        snprintf(iflist[3], IFNAME_SIZ, "%s", "lo");
+        if (syscfg_get(NULL, "wan_physical_ifname", wan_ifname, sizeof(wan_ifname)) == 0
+                && wan_ifname[0] != '\0')
+        {
+            snprintf(iflist[n++], IFNAME_SIZ, "%s", wan_ifname);
+        }
 
-        *nlist = 4;
-#endif
+        snprintf(iflist[n++], IFNAME_SIZ, "%s", "brlan0");
+        snprintf(iflist[n++], IFNAME_SIZ, "%s", "lo");
+
+        *nlist = n;
 #if defined(USE_TR181_PATH)
     }
     else
-- 
2.51.0

