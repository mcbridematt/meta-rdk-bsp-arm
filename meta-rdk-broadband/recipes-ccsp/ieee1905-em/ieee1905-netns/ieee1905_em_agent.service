[Unit]
Description=ieee1905 EasyMesh Agent service
Requires=ieee1905_netns.service
After=ieee1905_netns.service

[Service]
Type=notify
WorkingDirectory=/usr/ccsp/
ExecStartPre=/bin/sh -c 'mkdir -p /rdklogs/logs/ieee1905/agent'
ExecStart=/usr/bin/ieee1905 -f ieee1905::al_sap=trace,ieee1905::cmdu_handler=trace,ieee1905::cmdu_proxy=trace,ieee1905::cmdu_observer=trace -i eth0 --no-stdout-appender --file-appender /rdklogs/logs/ieee1905/agent
Restart=always
SyslogIdentifier=ieee1905_em_agent
NetworkNamespacePath=/var/run/netns/ieee1905

[Install]
WantedBy=multi-user.target
